# Values can also be entered through ffai's first-run setup wizard.
# Environment variables override values in this file.
# API keys for every provider are stored in OPENAI_API_KEY.

# OpenAI (default preset)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter
# OPENAI_API_KEY=sk-or-v1-your-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-5.4-mini

# DeepSeek
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash

# GLM (Zhipu)
# OPENAI_API_KEY=your-glm-key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-5.3

# Kimi (Moonshot)
# OPENAI_API_KEY=sk-your-kimi-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=kimi-k3.1-pro

# Qwen (DashScope, China region)
# OPENAI_API_KEY=sk-your-dashscope-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen3.8-flash
